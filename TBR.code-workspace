// optional but if using vscode, useful for organisation
{
   "folders": [
      { "path": ".", "name": "" }
   ],

   "settings": {
      "cmake.sourceDirectory": "${workspaceFolder}",
      "terminal.integrated.cwd": "${workspaceFolder}",
   },

   "launch": {
      "version": "0.2.0",
      "configurations": [
         {
            "name": "Debug (CodeLLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build",
            "console": "internalConsole",
            "expressions": "native",

            // to print a string with pretty formatting (no \t \n etc, run this cmd in debug console):
            // expr (void)printf("%s\n", mystr.c_str())
            // mystr can be replaced with any string type variable
            "initCommands": [
               "settings set target.language c++20" // lldb doesn't support c++23
            ],
         }
      ],
      "setupCommands": [
         {
            "description": "Enable pretty-printing for gdb/lldb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
         }
      ]
   },

   "tasks": {
      "version": "2.0.0",
      "tasks": [
         {
            "type": "cmake",
            "label": "CMake: build",
            "command": "build",
            "targets": ["all"],
            "preset": "${command:cmake.activeBuildPresetName}",
            "group": {
               "kind": "build",
               "isDefault": true
            },
            "problemMatcher": [],
         }
      ]
   },
   "extensions": {
      "recommendations": [
         "repreng.csv"
      ]
   }
}
